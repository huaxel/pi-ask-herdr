{
  "name": "@juanbenjumea/pi-ask-herdr",
  "version": "0.2.3",
  "description": "Pi extension that adds an ask_user tool and integrates with Herdr notifications/agent state.",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "herdr",
    "ask-user"
  ],
  "homepage": "https://github.com/huaxel/pi-ask-herdr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/huaxel/pi-ask-herdr"
  },
  "bugs": {
    "url": "https://github.com/huaxel/pi-ask-herdr/issues"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --strict --allowImportingTsExtensions --moduleResolution bundler --module esnext --target esnext --skipLibCheck index.ts src/*.ts tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "author": "Juan Benjumea"
}
